# Variáveis da API (só os nomes e valores de exemplo; nada de segredo aqui).
PORTA=4320
# Endereço em que a API escuta. No contêiner (T9.4), 0.0.0.0.
ENDERECO=127.0.0.1
# T10.14: tempos limite para receber o pedido e os cabeçalhos, em milissegundos.
TEMPO_DO_PEDIDO_EM_MS=15000
TEMPO_DOS_CABECALHOS_EM_MS=10000
ORIGENS_PERMITIDAS=http://127.0.0.1:4317
CAMINHO_CATALOGO=
NIVEL_DO_LOG=info
TEMPO_DO_CACHE_EM_SEGUNDOS=60
LIMITE_POR_MINUTO=60
# Opcional, do responsável: token do GitHub para subir o limite da API pública.
GITHUB_TOKEN=
CAMINHO_DO_BANCO=dados/painel.db
REPOSITORIO=sqlite
# T5.13 (do responsável): app OAuth do GitHub. Sem os dois, o login responde 503.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
URL_DE_RETORNO=
URL_DO_PAINEL=
# T9.9: METRICAS=sim liga GET /metricas (formato do Prometheus). Não exponha fora da rede interna.
METRICAS=
# T10.10: na hospedagem, atrás do proxy com TLS, SO_HTTPS=sim redireciona HTTP para HTTPS.
SO_HTTPS=
# T10.9: chave HMAC do cookie da sessão (32 caracteres ou mais; segredo do responsável).
# Sem ela, a API gera uma a cada início. A ANTERIOR só confere, durante a troca da chave.
CHAVE_DA_SESSAO=
CHAVE_DA_SESSAO_ANTERIOR=
# T5.14: logins do GitHub com papel de mantenedor, separados por vírgula.
MANTENEDORES=
# T6.12: com REPOSITORIO=mongo. A URL do banco publicado é segredo do responsável.
MONGO_URL=
MONGO_BANCO=painel
