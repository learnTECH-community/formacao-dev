{
  "name": "formacao-dev-api",
  "private": true,
  "type": "module",
  "description": "API do Painel de Formação (trilhas T5 e T6)",
  "engines": {
    "node": ">=24.10"
  },
  "scripts": {
    "start": "node src/servidor.mjs",
    "test": "node --test --test-timeout=60000 --test-reporter=spec \"test/**/*.test.mjs\"",
    "migrar": "node src/banco/migrar.mjs",
    "semear": "node src/banco/semear.mjs",
    "carga": "node carga/carga.mjs",
    "backup": "node src/banco/backup.mjs fazer",
    "restaurar": "node src/banco/backup.mjs restaurar"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autocannon": "^8.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
