{
  "name": "formacao-dev",
  "private": true,
  "type": "module",
  "description": "Catálogo de formação e Painel de Formação da learnTECH Community",
  "scripts": {
    "test": "node --test scripts/catalogo.test.mjs && vitest run",
    "test:e2e": "playwright test",
    "dev": "vite",
